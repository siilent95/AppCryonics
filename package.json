{
  "name": "cryopm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "trash:purge": "tsx scripts/purge-trash.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "user:create": "tsx scripts/create-user.ts",
    "db:import": "tsx scripts/import-sqlite.ts",
    "test:http": "npm run build && tsx scripts/test-http.ts",
    "qa:seed": "tsx scripts/seed-local-qa.ts --create-local-qa",
    "qa:catalog": "tsx scripts/seed-local-catalog-qa.ts --create-local-qa"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "drizzle-orm": "0.45.2",
    "next": "^16.4.3",
    "pdfjs-dist": "5.4.296",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "^17.9.0-beta.17",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.3",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
