# Example for nginx's http context. Replace domain and certificate paths.
# Run the Next.js production server on loopback :3000, never next dev.
limit_req_zone $binary_remote_addr zone=cryopm_auth:10m rate=10r/m;
# Avoid query strings, cookies, form bodies and tokens in access logs.
log_format cryopm_minimal '$request_method $uri $status $request_time';

server {
    listen 80;
    server_name cryopm.example.com;
    return 308 https://cryopm.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name cryopm.example.com;
    ssl_certificate /etc/letsencrypt/live/cryopm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cryopm.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 13m;
    access_log /var/log/nginx/cryopm-access.log cryopm_minimal;
    limit_req_status 429;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Overwrite untrusted client forwarding headers at the trusted edge.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_cache off;
    proxy_read_timeout 60s;

    location ~ ^/api/auth/(login|activate)$ {
        client_max_body_size 16k;
        limit_req zone=cryopm_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}
